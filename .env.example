# [INPUT]: 依赖仓库根 Docker Compose 与 scripts/gen-secrets.sh。
# [OUTPUT]: 提供 Compose 环境变量模板；生产密钥必须由外部注入，本文件不携带可用默认密钥。
# [POS]: DSH Enterprise（dshent）源码部署配置入口。复制为 .env 后填写；本地可先跑 scripts/gen-secrets.sh 生成密钥行。
# [PROTOCOL]: 变更时更新此头部，然后检查 FORK.md §5 / §6

# ── 镜像（本地源码构建时用根 docker-compose.override.yml） ──────────
# 拉取路径仍可指向历史 GHCR；本地构建默认标签为 dshent-*
OWNDSH_SERVER_IMAGE=ghcr.io/boe1900/owndsh-server:next
OWNDSH_CONSOLE_IMAGE=ghcr.io/boe1900/owndsh-console:next
OWNDSH_SERVER_LOCAL_IMAGE=dshent-server:0.1.0
OWNDSH_CONSOLE_LOCAL_IMAGE=dshent-console:0.1.0
OWNDSH_COMPOSE_PROJECT_NAME=dshent
OWNDSH_HTTP_BIND=0.0.0.0
OWNDSH_HTTP_PORT=8080

# 跨设备访问时改成部署机实际地址，例如 http://192.168.1.50:8080
# ENT_PUBLIC_BASE_URL=http://localhost:8080
ENT_DEPLOYMENT_TIME_ZONE=Asia/Shanghai

# ── 数据面（本地 demo 可弱口令；生产必须改） ────────────────────────
# 库名/库用户暂保持 owndsh，避免已有卷迁移；阶段三可评估更名
ENT_POSTGRES_DATABASE=owndsh
ENT_POSTGRES_USERNAME=owndsh
ENT_POSTGRES_PASSWORD=
ENT_REDIS_PASSWORD=

# ── 安全关键：禁止使用公开样例值；compose 缺失将拒绝启动 ────────────
# 生成：sh scripts/gen-secrets.sh   （或 openssl rand -hex 32）
SA_TOKEN_JWT_SECRET_KEY=
ENT_MASTER_KEY=

ENT_PLUGIN_SIGNING_ENABLED=false
ENT_PLUGIN_SIGNING_PRIVATE_KEY=

# ── 引导管理员（仅首次；登录后强制改密） ────────────────────────────
ENT_BOOTSTRAP_ADMIN_USERNAME=admin
ENT_BOOTSTRAP_ADMIN_PASSWORD=
