+    # ── 产品官网（部署层 /opt/owndsh/site/dist，只读 bind mount）──────────────────
+    # 公开策略：不鉴权、可索引（与两个文档门户一致）。CSP 为 script-src 'self'，
+    # 因此页面不得含内联脚本（主题前导已外置为 assets/theme-boot.js）。
+    location /home/ {
+      root /usr/share/nginx/html;
+      index index.html;
+      try_files $uri $uri/ =404;
+      error_page 404 /home/404.html;
+      add_header X-Content-Type-Options nosniff always;
+      add_header Referrer-Policy strict-origin-when-cross-origin always;
+      add_header X-Frame-Options DENY always;
+      add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" always;
+      add_header Cache-Control "no-cache" always;
+      gzip on;
+      gzip_comp_level 5;
+      gzip_types text/html text/css application/javascript application/json image/svg+xml;
+      gzip_min_length 1024;
+    }
+
+    # 站点地图与抓取策略必须在域名根：页面内引用的是 /sitemap.xml 与 /robots.txt
+    location = /sitemap.xml {
+      rewrite ^ /home/sitemap.xml break;
+      root /usr/share/nginx/html;
+      add_header Cache-Control "no-cache" always;
+    }
+
+    location = /robots.txt {
+      rewrite ^ /home/robots.txt break;
+      root /usr/share/nginx/html;
+      add_header Cache-Control "no-cache" always;
+    }
+
     location /assets/ {
