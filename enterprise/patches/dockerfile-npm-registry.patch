--- deploy/compose/Dockerfile.console.pre-npm-registry	2026-09-11 14:46:26.000000000 +0800
+++ deploy/compose/Dockerfile.console	2026-09-16 00:48:50.328495407 +0800
@@ -1,4 +1,4 @@
-# [INPUT]: 依赖 console pnpm 锁、完整 OpenAPI 真源，以及默认 registry 或受验本地 RepoDigest 提供的固定 Node/Nginx 镜像。
+# [INPUT]: 依赖 console pnpm 锁、完整 OpenAPI 真源、可由 OWNDSH_NPM_REGISTRY 切换的 npm 源，以及默认 registry 或受验本地 RepoDigest 提供的固定 Node/Nginx 镜像。
 # [OUTPUT]: 构建内含 TanStack 产品控制台静态资源与经构建期语法校验的 Nginx HTTP 配置的 Console 镜像。
 # [POS]: P2-08 唯一对外制品定义，浏览器和 Server 同域且不携带任何生产 secret。
 # [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
@@ -8,9 +8,13 @@
 ARG OWNDSH_NGINX_IMAGE=${OWNDSH_BASE_IMAGE_REGISTRY}/nginx:1.28.0-alpine3.21@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284
 FROM ${OWNDSH_NODE_IMAGE} AS build
 WORKDIR /workspace/console
+# 部署网络可能无法稳定访问 registry.npmjs.org；默认保持上游行为，
+# 用 --build-arg OWNDSH_NPM_REGISTRY=… 切换到国内镜像即可（本部署用腾讯云镜像）。
+ARG OWNDSH_NPM_REGISTRY=https://registry.npmjs.org/
 RUN npm install --global pnpm@11.24.0
 COPY console/package.json console/pnpm-lock.yaml console/pnpm-workspace.yaml ./
-RUN pnpm install --frozen-lockfile
+RUN pnpm config set registry ${OWNDSH_NPM_REGISTRY} \
+    && pnpm install --frozen-lockfile --registry=${OWNDSH_NPM_REGISTRY}
 COPY console/ ./
 COPY contracts/ /workspace/contracts/
 RUN pnpm build
