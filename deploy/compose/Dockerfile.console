# [INPUT]: 依赖 console pnpm 锁、完整 OpenAPI 真源，以及默认 registry 或受验本地 RepoDigest 提供的固定 Node/Nginx 镜像。
# [OUTPUT]: 构建内含 TanStack 产品控制台静态资源与经构建期语法校验的 Nginx HTTP 配置的 Console 镜像。
# [POS]: P2-08 唯一对外制品定义，浏览器和 Server 同域且不携带任何生产 secret。
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

ARG OWNDSH_BASE_IMAGE_REGISTRY=docker.io/library
ARG OWNDSH_NODE_IMAGE=${OWNDSH_BASE_IMAGE_REGISTRY}/node:24.6.0-alpine3.22@sha256:51dbfc749ec3018c7d4bf8b9ee65299ff9a908e38918ce163b0acfcd5dd931d9
ARG OWNDSH_NGINX_IMAGE=${OWNDSH_BASE_IMAGE_REGISTRY}/nginx:1.28.0-alpine3.21@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284
FROM ${OWNDSH_NODE_IMAGE} AS build
WORKDIR /workspace/console
RUN npm install --global pnpm@11.24.0
COPY console/package.json console/pnpm-lock.yaml console/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY console/ ./
COPY contracts/ /workspace/contracts/
RUN pnpm build

FROM ${OWNDSH_NGINX_IMAGE}
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
RUN sed 's/server server:8080;/server 127.0.0.1:8080;/' /etc/nginx/nginx.conf > /tmp/nginx.conf \
    && nginx -t -c /tmp/nginx.conf
COPY --from=build /workspace/console/dist/ /usr/share/nginx/html/
# 静态资源必须对运行用户 101:101 可读：console/public/ 由 Vite 原样拷进 dist/，Docker COPY 又原样保留
# 源文件权限；若源文件是 0660 root:root（Android/umask 007 检出后打包上传的常见结果），
# nginx worker（uid 101）读不到就整目录 403 —— /dshent-whale.png 是侧栏 logo、favicon 和登录页鲸鱼，
# 于是后台侧边栏 logo 变破图。这里统一放开读权限（目录补 x 以便遍历），与源文件权限解耦。
RUN chmod -R a+rX /usr/share/nginx/html
USER 101:101
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
