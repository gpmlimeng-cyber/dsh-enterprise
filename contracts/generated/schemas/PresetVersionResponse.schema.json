{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:PresetVersionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "packageId",
        "presetId",
        "sourceDshVersion",
        "sizeBytes",
        "sha256",
        "status",
        "createdAt",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "packageId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "presetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sourceDshVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sizeBytes": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 52428800
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "VALIDATED",
            "PUBLISHED",
            "RETIRED"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonic compare-and-swap revision safe in JavaScript.",
          "examples": [
            7
          ]
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}
