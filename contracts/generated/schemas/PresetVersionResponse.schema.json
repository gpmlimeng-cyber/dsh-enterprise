{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:PresetVersionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "packageId",
        "presetId",
        "sourceDshVersion",
        "sizeBytes",
        "sha256",
        "status",
        "createdAt",
        "revision",
        "dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "packageId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "presetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sourceDshVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sizeBytes": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 52428800
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "VALIDATED",
            "PUBLISHED",
            "RETIRED"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonic compare-and-swap revision safe in JavaScript.",
          "examples": [
            7
          ]
        },
        "dependencies": {
          "description": "上传时从 manifest.json 抄下来的引用清单，随版本冻结；无引用即空数组。",
          "type": "array",
          "maxItems": 200,
          "items": {
            "description": "配方版本引用的一项技能或插件（引用，不是快照）。`required: true` 的引用必须在发布口可解析， 否则服务端以 ENT_PRESET_REQUIRES_MISSING / ENT_PRESET_REQUIRES_NOT_PUBLISHED 拒绝发布。 同一形状同时被 runtime 摘要/详情投影复用（员工端只读清单，不含发布口校验语义）。",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "mode",
              "required"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "skill",
                  "plugin"
                ]
              },
              "id": {
                "description": "技能 skillId（`^[A-Za-z0-9][A-Za-z0-9._-]*$`，≤128）或 npm package name（≤214）。",
                "type": "string",
                "minLength": 1,
                "maxLength": 214
              },
              "mode": {
                "description": "pinned 钉 versionId；latest 跟该资产当前最新 PUBLISHED。",
                "type": "string",
                "enum": [
                  "pinned",
                  "latest"
                ]
              },
              "versionId": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "required": {
                "type": "boolean"
              },
              "resolvedVersionId": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$",
                "description": "留位字段（方案 §D 的可选第 6 键）：服务端在发布口解析\"当时最新\"后填充，只做展示与变更提示， 不是运行时真源。当前切片不填充，故服务端不会输出该键；manifest 里作者声明它会被验包拒绝。"
              }
            }
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}
