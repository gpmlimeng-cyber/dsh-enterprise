{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:BrandingPublicResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "name",
        "shortName",
        "logo",
        "welcome",
        "updatedAt"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Monotonic compare-and-swap revision safe in JavaScript.",
          "examples": [
            7
          ]
        },
        "name": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "shortName": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            {
              "type": "null"
            }
          ]
        },
        "logo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "light",
            "dark",
            "square"
          ],
          "properties": {
            "light": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "sha256",
                    "contentType",
                    "width",
                    "height",
                    "sizeBytes"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^/enterprise/api/v1/branding/assets/[1-9][0-9]{0,18}/[0-9a-f]{64}\\.(png|jpg|webp)$",
                      "description": "Content-addressed immutable URL scoped by the published revision."
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "contentType": {
                      "type": "string",
                      "enum": [
                        "image/png",
                        "image/jpeg",
                        "image/webp"
                      ]
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "sizeBytes": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 1,
                      "maximum": 524288
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "dark": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "sha256",
                    "contentType",
                    "width",
                    "height",
                    "sizeBytes"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^/enterprise/api/v1/branding/assets/[1-9][0-9]{0,18}/[0-9a-f]{64}\\.(png|jpg|webp)$",
                      "description": "Content-addressed immutable URL scoped by the published revision."
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "contentType": {
                      "type": "string",
                      "enum": [
                        "image/png",
                        "image/jpeg",
                        "image/webp"
                      ]
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "sizeBytes": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 1,
                      "maximum": 524288
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "square": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "sha256",
                    "contentType",
                    "width",
                    "height",
                    "sizeBytes"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^/enterprise/api/v1/branding/assets/[1-9][0-9]{0,18}/[0-9a-f]{64}\\.(png|jpg|webp)$",
                      "description": "Content-addressed immutable URL scoped by the published revision."
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "contentType": {
                      "type": "string",
                      "enum": [
                        "image/png",
                        "image/jpeg",
                        "image/webp"
                      ]
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "sizeBytes": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 1,
                      "maximum": 524288
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "welcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headline",
            "editionLabel"
          ],
          "properties": {
            "headline": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "editionLabel": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "updatedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}
