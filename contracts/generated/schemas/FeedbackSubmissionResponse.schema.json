{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:FeedbackSubmissionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "status",
        "occurredAt",
        "attachmentCount",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "issue",
            "suggestion"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "triaged",
            "resolved",
            "ignored"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "attachmentCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}
