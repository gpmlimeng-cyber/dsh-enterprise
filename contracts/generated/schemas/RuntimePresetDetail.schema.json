{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:RuntimePresetDetail",
  "allOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "presetId",
        "displayName",
        "description",
        "sourceDshVersion",
        "sizeBytes",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "presetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "sourceDshVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sizeBytes": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 52428800
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionId",
        "sha256"
      ],
      "properties": {
        "versionId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "downloadPath": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  ]
}
