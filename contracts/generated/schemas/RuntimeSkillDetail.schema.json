{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:RuntimeSkillDetail",
  "allOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "skillId",
        "displayName",
        "description",
        "sourceDshVersion",
        "sizeBytes",
        "skillCount",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "skillId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 32
        },
        "sourceDshVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sizeBytes": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 52428800
        },
        "skillCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionId",
        "sha256",
        "skills"
      ],
      "properties": {
        "versionId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "skills": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "modelInvocable",
              "userInvocable"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "whenToUse": {
                "type": "string",
                "maxLength": 2048
              },
              "modelInvocable": {
                "type": "boolean"
              },
              "userInvocable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  ]
}
