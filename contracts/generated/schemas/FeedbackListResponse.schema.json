{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owndsh:contracts:FeedbackListResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "requestId"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "page"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "status",
              "description",
              "contact",
              "submitterId",
              "attachmentCount",
              "occurredAt",
              "revision",
              "statusNote",
              "statusChangedBy",
              "statusChangedAt",
              "createdAt",
              "updatedAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "issue",
                  "suggestion"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "new",
                  "triaged",
                  "resolved",
                  "ignored"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 510
              },
              "contact": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 160
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "submitterId": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$",
                "description": "Enterprise user snowflake ID serialized as a string."
              },
              "attachmentCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time"
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Monotonic compare-and-swap revision safe in JavaScript.",
                "examples": [
                  7
                ]
              },
              "statusNote": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "statusChangedBy": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,18}$",
                    "description": "Enterprise user snowflake ID serialized as a string."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "statusChangedAt": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hasMore",
            "limit",
            "nextCursor"
          ],
          "properties": {
            "hasMore": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "nextCursor": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 16,
                  "maxLength": 512,
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "description": "Server-signed opaque cursor."
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "description": "Server-generated req_ prefix followed by one canonical ULID.",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ]
    }
  }
}
